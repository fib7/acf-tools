#!/usr/bin/env bash
# pre-push: backstop for AI attribution trailers.
#
# commit-msg fires only on `git commit` and `git merge`. It does NOT fire on
# `git cherry-pick` (how acf-whip's LP-CAS integrator lands every accepted
# branch), on rebase replay, or under --no-verify. This hook sees the whole
# pushed range and is the only client-side gate those three cannot dodge.
#
# Portable to stock macOS bash 3.2 + BSD grep. No GNU-isms.
set -u

remote_name="$1"
z='0000000000000000000000000000000000000000'
pat='^[[:space:]]*(Co-authored-by:.*(claude|anthropic\.com)|Claude-Session:)|Generated with \[?Claude Code'
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote ref pushes a null local sha; nothing to inspect.
  [ "$local_sha" = "$z" ] && continue

  # What this push ADDS to this remote, in both cases. The exclusion is `--remotes=<remote>` and not
  # just the old tip of this one branch: the policy is that THIS clone does not introduce AI-attributed
  # commits, and a commit already published on the remote is not being introduced by us. Without it,
  # merging any external branch that contains one — a fork sync, an upstream pull — is permanently
  # unpushable, while the offending commit sits on that remote either way. The new-branch case has
  # always had the correct scope; the existing-branch case did not, which is a range bug, not a
  # stricter policy. Every genuinely new commit is still inspected on both paths.
  range="$local_sha --not --remotes=$remote_name"
  [ "$remote_sha" = "$z" ] || range="$range $remote_sha"

  # `for c in $(git rev-list ...)` silently inspects NOTHING when rev-list fails (a bad ref, a shallow
  # clone, an unreachable sha) — the loop body never runs and the push sails through unchecked. A gate
  # that cannot compute its range has not passed; it has not run. Refuse instead.
  if ! revs=$(git rev-list $range 2>/dev/null); then
    echo "pre-push: REFUSED — could not compute the pushed range ($range)." >&2
    echo "          The attribution gate did not run, so this push is not verified." >&2
    exit 1
  fi

  for c in $revs; do
    if git log -1 --format=%B "$c" | grep -qiE "$pat"; then
      echo "pre-push: REJECTED $(git log -1 --format='%h %s' "$c")" >&2
      echo "          carries an AI attribution trailer." >&2
      fail=1
    fi
  done

  # STALENESS CHECK, and only when it can matter.
  #
  # `--remotes=<remote>` reads LOCAL remote-tracking refs, which are a cached belief about the
  # destination, not the destination. If a branch there was deleted or rewritten, a stale tracking
  # ref can exclude an attributed commit that this push reintroduces — and rev-list still succeeds,
  # so the refusal above never fires either.
  #
  # Fetching on every push to close that would be the wrong trade: slow, and broken offline, for a
  # hook that runs constantly. So pay nothing in the common case and check only when the exclusion is
  # actually load-bearing — when dropping it would have flagged something. Then one `ls-remote`
  # settles whether the tracking refs backing that exclusion are still current.
  strict="$local_sha"
  [ "$remote_sha" = "$z" ] || strict="$local_sha --not $remote_sha"
  hidden=""
  if strict_revs=$(git rev-list $strict 2>/dev/null); then
    for c in $strict_revs; do
      case " $revs " in *" $c "*) continue ;; esac        # already inspected above
      git log -1 --format=%B "$c" | grep -qiE "$pat" && hidden="$hidden $c"
    done
  fi
  if [ -n "$hidden" ]; then
    if ! ls_out=$(git ls-remote --heads "$remote_name" 2>/dev/null) || [ -z "$ls_out" ]; then
      echo "pre-push: REFUSED — an attributed commit is excluded because a local remote-tracking ref" >&2
      echo "          says it is already on '$remote_name', and that claim could not be verified" >&2
      echo "          (ls-remote failed). Run:  git fetch --prune $remote_name   and push again." >&2
      exit 1
    fi
    stale=0
    # (a) a tracking ref whose sha no longer matches the remote's.
    remote_names=""
    while read -r rsha rref; do
      [ -n "${rref:-}" ] || continue
      short="${rref#refs/heads/}"
      remote_names="$remote_names $short"
      track="refs/remotes/$remote_name/$short"
      lsha=$(git rev-parse --verify --quiet "$track" 2>/dev/null) || continue
      [ "$lsha" = "$rsha" ] || stale=1
    done <<EOF
$ls_out
EOF
    # (b) a tracking ref for a branch the remote no longer has AT ALL. This is the case that
    # actually excuses a reintroduced commit — the ref still points at it locally while nothing on
    # the destination does — and comparing only the refs the remote still reports cannot see it.
    # HEAD is a symref, not a branch; skip it.
    for track in $(git for-each-ref --format='%(refname)' "refs/remotes/$remote_name/" 2>/dev/null); do
      short="${track#refs/remotes/$remote_name/}"
      [ "$short" = "HEAD" ] && continue
      case " $remote_names " in *" $short "*) ;; *) stale=1 ;; esac
    done
    if [ "$stale" -ne 0 ]; then
      echo "pre-push: REFUSED — this push reintroduces commit(s) carrying an AI attribution trailer:" >&2
      for c in $hidden; do echo "            $(git log -1 --format='%h %s' "$c")" >&2; done
      echo "          They were excluded as 'already on $remote_name', but your remote-tracking refs" >&2
      echo "          for that remote are out of date, so that exclusion cannot be trusted. Run:" >&2
      echo "            git fetch --prune $remote_name" >&2
      echo "          and push again — if they really are still published there, this will pass." >&2
      exit 1
    fi
  fi
done

if [ "$fail" -ne 0 ]; then
  {
    echo
    echo "  This repository does not record AI co-authorship in git history."
    echo "  Rewrite the offending messages before pushing:"
    echo "      git rebase -i <base>    (reword each commit)"
    echo "      git commit --amend      (if it is the tip)"
    echo
    echo "  commit-msg does not fire on cherry-pick or rebase replay, which is"
    echo "  why these reached the push. ALLOWED trailers: ACFW-Stage:,"
    echo "  ACFW-Task:, ACFW-Patch:, and human Co-authored-by: lines."
  } >&2
  exit 1
fi

exit 0
