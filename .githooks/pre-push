#!/usr/bin/env bash
# pre-push: backstop for AI attribution trailers.
#
# commit-msg fires only on `git commit` and `git merge`. It does NOT fire on
# `git cherry-pick` (how acf-whip's LP-CAS integrator lands every accepted
# branch), on rebase replay, or under --no-verify. This hook sees the whole
# pushed range and is the only client-side gate those three cannot dodge.
#
# Portable to stock macOS bash 3.2 + BSD grep. No GNU-isms.
set -u

remote_name="$1"
z='0000000000000000000000000000000000000000'
pat='^[[:space:]]*(Co-authored-by:.*(claude|anthropic\.com)|Claude-Session:)|Generated with \[?Claude Code'
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote ref pushes a null local sha; nothing to inspect.
  [ "$local_sha" = "$z" ] && continue

  # What this push ADDS to this remote, in both cases. The exclusion is `--remotes=<remote>` and not
  # just the old tip of this one branch: the policy is that THIS clone does not introduce AI-attributed
  # commits, and a commit already published on the remote is not being introduced by us. Without it,
  # merging any external branch that contains one — a fork sync, an upstream pull — is permanently
  # unpushable, while the offending commit sits on that remote either way. The new-branch case has
  # always had the correct scope; the existing-branch case did not, which is a range bug, not a
  # stricter policy. Every genuinely new commit is still inspected on both paths.
  range="$local_sha --not --remotes=$remote_name"
  [ "$remote_sha" = "$z" ] || range="$range $remote_sha"

  # `for c in $(git rev-list ...)` silently inspects NOTHING when rev-list fails (a bad ref, a shallow
  # clone, an unreachable sha) — the loop body never runs and the push sails through unchecked. A gate
  # that cannot compute its range has not passed; it has not run. Refuse instead.
  if ! revs=$(git rev-list $range 2>/dev/null); then
    echo "pre-push: REFUSED — could not compute the pushed range ($range)." >&2
    echo "          The attribution gate did not run, so this push is not verified." >&2
    exit 1
  fi

  for c in $revs; do
    if git log -1 --format=%B "$c" | grep -qiE "$pat"; then
      echo "pre-push: REJECTED $(git log -1 --format='%h %s' "$c")" >&2
      echo "          carries an AI attribution trailer." >&2
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  {
    echo
    echo "  This repository does not record AI co-authorship in git history."
    echo "  Rewrite the offending messages before pushing:"
    echo "      git rebase -i <base>    (reword each commit)"
    echo "      git commit --amend      (if it is the tip)"
    echo
    echo "  commit-msg does not fire on cherry-pick or rebase replay, which is"
    echo "  why these reached the push. ALLOWED trailers: ACFW-Stage:,"
    echo "  ACFW-Task:, ACFW-Patch:, and human Co-authored-by: lines."
  } >&2
  exit 1
fi

exit 0
