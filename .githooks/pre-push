#!/usr/bin/env bash
# pre-push: backstop for AI attribution trailers.
#
# commit-msg fires only on `git commit` and `git merge`. It does NOT fire on
# `git cherry-pick` (how acf-whip's LP-CAS integrator lands every accepted
# branch), on rebase replay, or under --no-verify. This hook sees the whole
# pushed range and is the only client-side gate those three cannot dodge.
#
# Portable to stock macOS bash 3.2 + BSD grep. No GNU-isms.
set -u

remote_name="$1"
z='0000000000000000000000000000000000000000'
pat='^[[:space:]]*(Co-authored-by:.*(claude|anthropic\.com)|Claude-Session:)|Generated with \[?Claude Code'
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote ref pushes a null local sha; nothing to inspect.
  [ "$local_sha" = "$z" ] && continue

  if [ "$remote_sha" = "$z" ]; then
    # New branch: inspect what this push adds beyond anything already on the remote.
    range="$local_sha --not --remotes=$remote_name"
  else
    range="$remote_sha..$local_sha"
  fi

  for c in $(git rev-list $range); do
    if git log -1 --format=%B "$c" | grep -qiE "$pat"; then
      echo "pre-push: REJECTED $(git log -1 --format='%h %s' "$c")" >&2
      echo "          carries an AI attribution trailer." >&2
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  {
    echo
    echo "  This repository does not record AI co-authorship in git history."
    echo "  Rewrite the offending messages before pushing:"
    echo "      git rebase -i <base>    (reword each commit)"
    echo "      git commit --amend      (if it is the tip)"
    echo
    echo "  commit-msg does not fire on cherry-pick or rebase replay, which is"
    echo "  why these reached the push. ALLOWED trailers: ACFW-Stage:,"
    echo "  ACFW-Task:, ACFW-Patch:, and human Co-authored-by: lines."
  } >&2
  exit 1
fi

exit 0
