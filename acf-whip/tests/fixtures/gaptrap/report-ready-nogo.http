{"jsonrpc":"2.0","id":1,"result":{"content":[{"type":"text","text":"{\"specId\":\"Xy12pQ7rT3uV9wZ1aB4c\",\"orgId\":\"org7f3k2m9\",\"feedback\":{},\"conventionResolutions\":{},\"report\":{\"report_id\":\"r-0001\",\"verdict\":\"NO-GO\",\"verdictSummary\":\"A required template section is missing.\",\"completeness_score\":62,\"confidence_score\":80,\"analysis_time_ms\":12840,\"total_gaps\":3,\"critical\":0,\"high\":2,\"medium\":1,\"low\":0,\"gaps\":[{\"gap_id\":\"3f0c9a52-1d7e-4b8a-9c11-2e5f7a6b8d01\",\"pattern\":\"undefined_behavior\",\"severity\":\"high\",\"title\":\"Per-seat price has no billing period\",\"description\":\"The notice quotes a per-seat price but never says whether it is monthly or annual.\",\"impact_summary\":\"Owners may misread the charge and dispute it.\",\"extraction_text\":\"the per-seat price\",\"source_offset\":[211,229],\"resolution_questions\":[{\"question\":\"Is the per-seat price shown per month or per year? (default: per month)\",\"impact\":\"Sets the unit the email quotes.\"}]},{\"gap_id\":\"8b2d4e6f-0a1c-4d3e-8f5a-6b7c9d0e1f23\",\"pattern\":\"missing_state_handling\",\"severity\":\"medium\",\"title\":\"No behavior when the audit write fails\",\"description\":\"Nothing says what happens to the seat change when the audit row cannot be written.\",\"impact_summary\":\"A silent audit gap on billing events.\",\"extraction_text\":\"Record every seat change\",\"source_offset\":[252,276],\"resolution_questions\":[{\"question\":\"Should a failed audit write block the seat change?\",\"impact\":\"Decides consistency versus availability.\"},{\"question\":\"How long are audit rows kept? (default: forever)\",\"impact\":\"\"}]},{\"gap_id\":\"missing-section-functional_acceptance-f7377e4def423175\",\"pattern\":\"missing_required_section\",\"severity\":\"high\",\"title\":\"Functional Acceptance Criteria is empty\",\"description\":\"The Functional Acceptance Criteria section is required but the spec leaves it empty. It must be filled before the spec is build-ready.\",\"impact_summary\":\"Without the Functional Acceptance Criteria section, an AI agent has no grounding for this required part of the spec.\",\"extraction_text\":\"Functional Acceptance Criteria (section is empty)\",\"source_offset\":[0,0],\"resolution_questions\":[{\"question\":\"What should be true before, what does the user do, and what should they see afterwards?\",\"impact\":\"The Functional Acceptance Criteria section stays empty and blocks the verdict until it is filled.\"}]}],\"contract\":{\"outcome_and_why\":{\"value\":\"Owners know what a new seat costs\"}},\"linter\":null,\"handoffGate\":null,\"contractStatus\":\"ready\",\"createdAt\":\"2026-09-28T10:00:00.000Z\",\"analysisMode\":\"standard\",\"conventionNotes\":[],\"kbProvenance\":null}}"}]}}
