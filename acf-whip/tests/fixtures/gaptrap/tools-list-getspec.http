{"jsonrpc":"2.0","id":1,"result":{"tools":[{"name":"create_spec","description":"Submit a spec for analysis. Returns immediately with {specId, status:'pending'}; analysis runs asynchronously.","inputSchema":{"type":"object","properties":{"spec":{"type":"string","minLength":1,"description":"The spec text to analyze."},"format":{"type":"string","enum":["text","markdown"]},"filename":{"type":["string","null"]},"mode":{"type":"string","enum":["standard","multipass"]},"templateId":{"type":"string"},"folderId":{"type":["string","null"],"description":"Target folder id; omit for no folder."}},"required":["spec"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"}},{"name":"get_analysis_status","description":"Read a spec's analysis status and light metadata.","inputSchema":{"type":"object","properties":{"specId":{"type":"string","minLength":1}},"required":["specId"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"}},{"name":"get_analysis_report","description":"Read a spec's latest analysis report plus feedback and convention-note resolutions. `report` is null until analysis completes.","inputSchema":{"type":"object","properties":{"specId":{"type":"string","minLength":1}},"required":["specId"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"}},{"name":"list_specs","description":"List the caller's specs, newest first, cursor-paginated.","inputSchema":{"type":"object","properties":{"limit":{"type":"integer","exclusiveMinimum":0},"cursor":{"type":"string"}},"required":[],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"}},{"name":"list_folders","description":"List the caller's folders.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"}},{"name":"create_folder","description":"Create a folder.","inputSchema":{"type":"object","properties":{"name":{"type":"string","minLength":1}},"required":["name"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"}},{"name":"move_spec","description":"Move a spec into a folder.","inputSchema":{"type":"object","properties":{"specId":{"type":"string","minLength":1},"folderId":{"type":["string","null"]}},"required":["specId"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"}},{"name":"get_spec","description":"Read a spec's submitted content.","inputSchema":{"type":"object","properties":{"specId":{"type":"string","minLength":1}},"required":["specId"],"additionalProperties":false,"$schema":"http://json-schema.org/draft-07/schema#"}}]}}
